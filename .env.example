VARIANTCOURT_MODE=demo
MAX_ROUNDS=3

# Weights & Biases (Weave tracing + ARIA runs)
WANDB_API_KEY=
WANDB_PROJECT=variantcourt
WANDB_ENTITY=

# CoreWeave inference (OpenAI-compatible)
COREWEAVE_API_KEY=
COREWEAVE_BASE_URL=https://api.inference.wandb.ai/v1   # W&B Inference (CoreWeave-hosted); uses WANDB_API_KEY if COREWEAVE_API_KEY is empty
COREWEAVE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# TypeSafe AI
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=

# Optional fallback model endpoint (OpenAI-compatible)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# Evidence: live (ClinVar/VEP/gnomAD/Europe PMC, cached) | fixtures
EVIDENCE_MODE=live

# NCBI E-utilities (ClinVar): optional key raises the limit from 3 to 10 requests/s
NCBI_API_KEY=

# Production
CORS_ORIGINS=*            # comma-separated allowed origins, e.g. https://variantcourt.example.com
MAX_CONCURRENT_CASES=4    # cases running at once; each hits live evidence APIs + several LLM calls
VARIANTCOURT_DB=variantcourt.db
