# Docker's --env-file does not strip inline comments: keep comments on their own lines.
VARIANTCOURT_MODE=demo
MAX_ROUNDS=3

# Weights & Biases (Weave tracing + ARIA runs)
WANDB_API_KEY=
WANDB_PROJECT=variantcourt
WANDB_ENTITY=

# CoreWeave inference (OpenAI-compatible)
COREWEAVE_API_KEY=
# W&B Inference (CoreWeave-hosted); uses WANDB_API_KEY if COREWEAVE_API_KEY is empty
COREWEAVE_BASE_URL=https://api.inference.wandb.ai/v1
COREWEAVE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# TypeSafe AI: Jev checks every claim against its cited evidence each round (key alone is enough)
TYPESAFE_API_KEY=
# default https://api.typesafe.ai
TYPESAFE_BASE_URL=
# default jev-latest
TYPESAFE_MODEL=

# Verdict scoring: rules (Richards 2015, default) | points (Tavtigian Bayesian points; conflicts net out)
ACMG_SCORING=rules

# Optional fallback model endpoint (OpenAI-compatible)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# Evidence: live (ClinVar/VEP/gnomAD/Europe PMC, cached) | fixtures
EVIDENCE_MODE=live

# NCBI E-utilities (ClinVar): optional key raises the limit from 3 to 10 requests/s
NCBI_API_KEY=

# Production
# comma-separated allowed origins, e.g. https://variantcourt.example.com
CORS_ORIGINS=*
# cases running at once; each hits live evidence APIs + several LLM calls
MAX_CONCURRENT_CASES=4
VARIANTCOURT_DB=variantcourt.db
